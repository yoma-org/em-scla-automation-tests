# Copy to .env in this folder (git-ignored). Old EM UAT only, never production.
BASE_URL=https://www.uat.ted.synergy.yomaland360.com
API_BASE_URL=https://www.uat.ted-bkend.synergy.yomaland360.com/api

# Old EM accounts (the New EM accounts in projects/em/.env do not work here).
# ADMIN creates documents (maker). APPROVER approves them (checker); it must be a different
# account if Old EM blocks self-approval (source-issues.md D1). Leave APPROVER_* empty to
# approve with ADMIN.
ADMIN_EMAIL=
ADMIN_PASSWORD=
APPROVER_EMAIL=
APPROVER_PASSWORD=

# Partner API (estate-billing-api) used by tests/api/: the "Application URL" on Settings › API Access
# + /api. Not a secret. The tests create their own API key in Settings › API Access.
PARTNER_API_BASE_URL=https://www.uat.ted-api.synergy.yomaland360.com/api
